{
  "ratatoskr_services": [
    {
      "name": "edge",
      "repository": "platform",
      "unit": "ratatoskr-edge.service",
      "binary": "ratatoskr-edge",
      "user": "ratatoskr-edge",
      "config_example": "deploy/systemd/edge.conf.example",
      "config": "/etc/ratatoskr/edge.conf",
      "database_role": "ratatoskr_edge",
      "role_file": false,
      "operator_port": 9464,
      "settings": {
        "RATATOSKR__IDENTITY__ASSERTION_KEY": "{file:/etc/ratatoskr/secrets/telegram-platform-signing-key.pub}",
        "RATATOSKR__CHANNEL_DIGESTS__SERVICE_SECRET": "{file:/etc/ratatoskr/secrets/channel-digests-service-secret}",
        "RATATOSKR__SITES__GATEWAY_PEER": "127.0.0.83"
      }
    },
    {
      "name": "ingest",
      "repository": "platform",
      "unit": "ratatoskr-ingest.service",
      "binary": "ratatoskr-ingest",
      "user": "ratatoskr-ingest",
      "config_example": "deploy/systemd/ingest.conf.example",
      "config": "/etc/ratatoskr/ingest.conf",
      "database_role": "ratatoskr_ingest",
      "role_file": false,
      "operator_port": 9465,
      "settings": {}
    },
    {
      "name": "scheduler",
      "repository": "platform",
      "unit": "ratatoskr-scheduler.service",
      "binary": "ratatoskr-scheduler",
      "user": "ratatoskr-scheduler",
      "config_example": "deploy/systemd/scheduler.conf.example",
      "config": "/etc/ratatoskr/scheduler.conf",
      "database_role": "ratatoskr_scheduler",
      "role_file": false,
      "operator_port": 9466,
      "settings": {}
    },
    {
      "name": "extractor",
      "repository": "extractor",
      "unit": "ratatoskr-extractor.service",
      "binary": "ratatoskr-extractor",
      "user": "ratatoskr-extractor",
      "config_example": "deploy/systemd/extractor.conf.example",
      "config": "/etc/ratatoskr/extractor.conf",
      "database_role": "ratatoskr_extractor",
      "role_file": true,
      "operator_port": 9088,
      "settings": {}
    },
    {
      "name": "telegram-webhook",
      "repository": "telegram",
      "unit": "ratatoskr-telegram-webhook.service",
      "binary": "ratatoskr-telegram-webhook",
      "user": "ratatoskr-telegram-webhook",
      "config_example": "deploy/systemd/webhook.conf.example",
      "config": "/etc/ratatoskr/telegram-webhook.conf",
      "database_role": "ratatoskr_telegram",
      "role_file": true,
      "operator_port": 9467,
      "settings": {
        "RATATOSKR__ACCESS__OWNER_TELEGRAM_USER_ID": "{{ ratatoskr_telegram_owner_user_id }}"
      }
    },
    {
      "name": "telegram-dispatcher",
      "repository": "telegram",
      "unit": "ratatoskr-telegram-dispatcher.service",
      "binary": "ratatoskr-telegram-dispatcher",
      "user": "ratatoskr-telegram-dispatcher",
      "config_example": "deploy/systemd/dispatcher.conf.example",
      "config": "/etc/ratatoskr/telegram-dispatcher.conf",
      "database_role": "ratatoskr_telegram",
      "role_file": true,
      "operator_port": 9468,
      "settings": {}
    },
    {
      "name": "knowledge",
      "repository": "knowledge",
      "unit": "ratatoskr-knowledge.service",
      "binary": "ratatoskr-knowledge-service",
      "user": "ratatoskr-knowledge",
      "config_example": "deploy/systemd/knowledge.conf.example",
      "config": "/etc/ratatoskr/knowledge.conf",
      "database_role": "ratatoskr_knowledge",
      "role_file": true,
      "operator_port": 9081,
      "ready_path": "/ready",
      "settings": {
        "RATATOSKR__STORAGE__DATABASE_URL": "postgres://ratatoskr_knowledge:{file:/etc/ratatoskr/secrets/postgres/ratatoskr_knowledge.password}@127.0.0.1:5432/ratatoskr",
        "RATATOSKR__PROVIDER__OPENROUTER__API_KEY": "{file:/etc/ratatoskr/secrets/openrouter-api-key}",
        "RATATOSKR__INGEST__GITHUB_README_SERVICE_SECRET": "{file:/etc/ratatoskr/secrets/github-readme-service-secret}",
        "RATATOSKR__CHANNEL_RECAP__DIGEST_SOURCE_SERVICE_SECRET": "{file:/etc/ratatoskr/secrets/channel-digests-source-secret}",
        "RATATOSKR__CHANNEL_RECAP__RESULT_READER_SERVICE_SECRET": "{file:/etc/ratatoskr/secrets/channel-digests-result-reader-secret}"
      }
    },
    {
      "name": "sites",
      "repository": "sites",
      "unit": "ratatoskr-sites.service",
      "binary": "ratatoskr-sites",
      "user": "ratatoskr-sites",
      "config_example": "deploy/systemd/sites.conf.example",
      "config": "/etc/ratatoskr/sites.conf",
      "database_role": "ratatoskr_sites",
      "role_file": true,
      "operator_port": 9472,
      "ready_path": "/health/ready",
      "settings": {
        "RATATOSKR__DATABASE__URL": "postgres://ratatoskr_sites:{file:/etc/ratatoskr/secrets/postgres/ratatoskr_sites.password}@127.0.0.1:5432/ratatoskr",
        "RATATOSKR__BUS__URL": "nats://127.0.0.1:4222",
        "RATATOSKR__BUS__NKEY_SEED_PATH": "/etc/ratatoskr/sites.nkey"
      }
    },
    {
      "name": "sites-gateway",
      "repository": "sites",
      "unit": "ratatoskr-sites-gateway.service",
      "binary": "ratatoskr-sites-gateway",
      "user": "ratatoskr-sites-gateway",
      "config_example": "deploy/systemd/sites-gateway.conf.example",
      "config": "/etc/ratatoskr/sites-gateway.conf",
      "database_role": "ratatoskr_sites",
      "role_file": false,
      "operator_port": 9473,
      "ready_path": "/health/ready",
      "settings": {}
    }
  ],
  "ratatoskr_template_units": [
    {"repository": "notes", "unit": "ratatoskr-notes-cleanup@.service", "manager": "ratatoskr-notes"},
    {"repository": "notes", "unit": "ratatoskr-notes-login@.service", "manager": "ratatoskr-notes"},
    {"repository": "notes", "unit": "ratatoskr-notes-sync-bidi@.service", "manager": "ratatoskr-notes"},
    {"repository": "notes", "unit": "ratatoskr-notes-sync-pull@.service", "manager": "ratatoskr-notes"}
  ],
  "ratatoskr_database_roles": [
    {"repository": "extractor", "role": "ratatoskr_extractor"},
    {"repository": "telegram", "role": "ratatoskr_telegram"},
    {"repository": "knowledge", "role": "ratatoskr_knowledge"},
    {"repository": "github", "role": "ratatoskr_github"},
    {"repository": "vault", "role": "ratatoskr_vault"},
    {"repository": "channel-digests", "role": "ratatoskr_channel_digests"},
    {"repository": "chatgpt", "role": "ratatoskr_chatgpt"},
    {"repository": "claude", "role": "ratatoskr_claude"},
    {"repository": "x", "role": "ratatoskr_x"},
    {"repository": "instagram", "role": "ratatoskr_instagram"},
    {"repository": "threads", "role": "ratatoskr_threads"},
    {"repository": "notes", "role": "ratatoskr_notes"},
    {"repository": "sites", "role": "ratatoskr_sites"}
  ],
  "ratatoskr_nats_identities": [
    {"identity": "edge", "group": "ratatoskr-edge"},
    {"identity": "telegram", "group": "ratatoskr-telegram-dispatcher"},
    {"identity": "extractor", "group": "ratatoskr-extractor"},
    {"identity": "chatgpt", "group": "root"},
    {"identity": "claude", "group": "root"},
    {"identity": "x", "group": "root"},
    {"identity": "instagram", "group": "root"},
    {"identity": "threads", "group": "root"},
    {"identity": "extractor-browser-worker", "group": "root"},
    {"identity": "knowledge", "group": "ratatoskr-knowledge"},
    {"identity": "github", "group": "root"},
    {"identity": "vault", "group": "root"},
    {"identity": "channel-digests", "group": "root"},
    {"identity": "notes", "group": "root"},
    {"identity": "sites", "group": "ratatoskr-sites"}
  ]
}
